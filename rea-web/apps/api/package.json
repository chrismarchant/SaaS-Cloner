{
  "name": "@rea-web/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/main.js",
    "dev": "node --watch --import tsx dist/main.js"
  },
  "bin": {
    "rea-web-api": "./dist/main.js"
  },
  "dependencies": {
    "@rea-web/contracts": "0.1.0",
    "@rea-web/db": "0.1.0",
    "@rea-web/storage": "0.1.0",
    "fastify": "5.12.5",
    "@fastify/cookie": "11.0.2",
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "8.3.0",
    "@fastify/cors": "11.2.0",
    "pino": "10.4.0"
  }
}
